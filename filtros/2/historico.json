    "ppt_url": "https://contrataciondelestado.es/FileSystem/servlet/GetDocumentByIdServlet?cifrado=QUC1GjXXSiLkydRHJBmbpw%3D%3D&DocumentIdParam=vUMKT9XnXqy1lcIoSmYaVMf5b%2BQxTscgrASt//B/d81ODSgiUYPq3TJG6P/olQQSXpdWjXRexq27sDQFBhWkSJwkbhuW/X5MqNziPoC%2Bsim1aXEvq3KHa/AEHgtDrQw0",
    "organo": "Junta de Gobierno del Ayuntamiento de Burgos",
    "importe": "932666.15",
    "importe_num": 932666.15,
    "fecha_limite": "2026-06-30",
